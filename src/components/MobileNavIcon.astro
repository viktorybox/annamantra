---
type IconName = 'home' | 'practice' | 'quiz' | 'blog' | 'more';
interface Props { name: IconName }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'home' && <><path d="m3 10 9-7 9 7" /><path d="M5 9v12h14V9M9 21v-7h6v7" /></>}
  {name === 'practice' && <><path d="M12 3c.8 4.6 2.4 6.2 7 7-4.6.8-6.2 2.4-7 7-.8-4.6-2.4-6.2-7-7 4.6-.8 6.2-2.4 7-7Z" /><path d="M19 17c.3 1.3 1 2 2.3 2.3C20 19.6 19.3 20.3 19 21.6c-.3-1.3-1-2-2.3-2.3C18 19 18.7 18.3 19 17Z" /></>}
  {name === 'quiz' && <><circle cx="12" cy="12" r="9" /><path d="M9.3 9.1a2.8 2.8 0 0 1 5.4 1c0 1.8-2.7 2-2.7 4" /><circle cx="12" cy="17" r=".7" fill="currentColor" stroke="none" /></>}
  {name === 'blog' && <><path d="M6 3.5h12a2 2 0 0 1 2 2v15H7a3 3 0 0 1-3-3v-12a2 2 0 0 1 2-2Z" /><path d="M4 17.5a3 3 0 0 1 3-3h13M8 8h8M8 11h6" /></>}
  {name === 'more' && <><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></>}
</svg>
