---
import { getCopy, type Locale } from '@/data/site';

interface Props { locale: Locale; languageSwitchHref?: string }
const { locale, languageSwitchHref } = Astro.props;
const text = getCopy(locale);
const otherLocale = locale === 'ru' ? 'fr' : 'ru';
const alternatePathMap: Record<string, string> = {
  '/ru/privacy/': '/fr/confidentialite/',
  '/fr/confidentialite/': '/ru/privacy/',
};
const otherPath = languageSwitchHref ?? alternatePathMap[Astro.url.pathname] ?? Astro.url.pathname.replace(`/${locale}/`, `/${otherLocale}/`);
const isHome = Astro.url.pathname === `/${locale}/`;
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand-slot" href={`/${locale}/`} aria-label={locale === 'ru' ? 'На главную' : 'Accueil'}>
      <picture>
        <source srcset="/images/logo.webp" type="image/webp" />
        <img src="/images/logo.png" alt="Anna Mantra" width="56" height="56" />
      </picture>
    </a>

    <nav class="desktop-nav" aria-label={locale === 'ru' ? 'Основная навигация' : 'Navigation principale'}>
      {text.nav.map((item) => <a href={!isHome && item.href.startsWith('#') ? `/${locale}/${item.href}` : item.href}>{item.label}</a>)}
    </nav>

    <nav class="language-switch" aria-label={text.languageSwitchLabel} data-current={locale}>
      <a class:list={{ active: locale === 'ru' }} href={locale === 'ru' ? Astro.url.pathname : otherPath} aria-current={locale === 'ru' ? 'page' : undefined} data-locale="ru" data-astro-reload lang="ru" aria-label={locale === 'ru' ? 'Русский, выбран' : 'Passer en russe'}>RU</a>
      <a class:list={{ active: locale === 'fr' }} href={locale === 'fr' ? Astro.url.pathname : otherPath} aria-current={locale === 'fr' ? 'page' : undefined} data-locale="fr" data-astro-reload lang="fr" aria-label={locale === 'fr' ? 'Français, sélectionné' : 'Переключить на французский'}>FR</a>
    </nav>
  </div>
</header>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let languageTimer: number | undefined;

  document.addEventListener('click', (event) => {
    if (!(event instanceof MouseEvent) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[data-locale]');
    if (!link) return;
    const switcher = link.closest<HTMLElement>('.language-switch');
    if (!switcher) return;

    event.preventDefault();
    if (languageTimer) window.clearTimeout(languageTimer);
    if (link.dataset.locale === document.documentElement.lang) {
      switcher.dataset.current = link.dataset.locale;
      switcher.querySelectorAll<HTMLAnchorElement>('a[data-locale]').forEach((item) => item.classList.toggle('active', item === link));
      return;
    }
    switcher.dataset.current = link.dataset.locale;
    switcher.querySelectorAll<HTMLAnchorElement>('a[data-locale]').forEach((item) => item.classList.toggle('active', item === link));
    languageTimer = window.setTimeout(() => window.location.assign(link.href), reduceMotion.matches ? 0 : 260);
  });
</script>
