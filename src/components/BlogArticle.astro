---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { toHTML, escapeHTML, uriLooksSafe } from '@portabletext/to-html';
import { getVisibleBlogPosts, type BlogPost } from '@/data/blog';
import { verifiedExternalUrl } from '@/data/connections';
import type { Locale } from '@/data/site';

interface Props { post: BlogPost; locale: Locale }
const { post, locale } = Astro.props;
const isRu = locale === 'ru';
const rendered = post.source === 'local' ? await render(post.entry) : null;
const Content = rendered?.Content;
const html = post.source === 'cms' ? toHTML(post.body, {
  components: {
    marks: {
      link: ({ children, value }) => typeof value?.href === 'string' && uriLooksSafe(value.href)
        ? `<a href="${escapeHTML(value.href)}" rel="noopener noreferrer">${children}</a>` : children,
    },
    types: {
      image: ({ value }) => {
        const url = verifiedExternalUrl(value?.asset?.url);
        return url ? `<figure><img src="${escapeHTML(url)}?w=1400&amp;auto=format&amp;fit=max" alt="${escapeHTML(value.alt ?? '')}" loading="lazy" /></figure>` : '';
      },
    },
  },
}) : '';
const related = (await getVisibleBlogPosts(locale)).filter((item) => item.id !== post.id && item.data.status === 'published').slice(0, 2);
const otherLocale = isRu ? 'fr' : 'ru';
const alternate = post.translationSlug ? `/${otherLocale}/blog/${post.translationSlug}/` : null;
---

<BaseLayout locale={locale} title={post.data.seoTitle} description={post.data.description}
  noindex={post.data.status === 'draft'} alternateHref={alternate} languageSwitchHref={alternate ?? `/${otherLocale}/blog/`}>
  <article class="article-page">
    <header class="article-header">
      <a class="back-home" href={`/${locale}/blog/`}><span aria-hidden="true">←</span> {isRu ? 'Все статьи' : 'Tous les articles'}</a>
      <p class="eyebrow">{post.data.status === 'draft' ? (isRu ? 'Черновик · предпросмотр' : 'Brouillon · aperçu') : (isRu ? 'Блог Анны' : 'Le blog d’Anna')}</p>
      <h1>{post.data.title}</h1>
      <p class="article-excerpt">{post.data.excerpt}</p>
      {post.data.publishedAt && <time datetime={post.data.publishedAt}>{new Date(`${post.data.publishedAt}T12:00:00Z`).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' })}</time>}
    </header>
    {Content ? <div class="article-body"><Content /></div> : <div class="article-body" set:html={html} />}
    {related.length > 0 && <aside class="article-related" aria-label={isRu ? 'Ещё статьи' : 'Autres articles'}>
      <h2>{isRu ? 'Ещё в блоге' : 'À lire aussi'}</h2>
      {related.map((item) => <a class="text-link" href={`/${locale}/blog/${item.id}/`}>{item.data.title}<span aria-hidden="true">↗</span></a>)}
    </aside>}
    <footer class="article-footer"><a class="text-link" href={`/${locale}/blog/`}>{isRu ? 'Вернуться к блогу' : 'Retour au blog'} <span aria-hidden="true">→</span></a></footer>
  </article>
</BaseLayout>
