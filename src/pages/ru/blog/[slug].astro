---
import BlogArticle from '@/components/BlogArticle.astro';
import { getVisibleBlogPosts, type BlogPost } from '@/data/blog';

export async function getStaticPaths() {
  const entries = await getVisibleBlogPosts('ru');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: BlogPost }
const { entry } = Astro.props;
---
<BlogArticle post={entry} locale="ru" />
