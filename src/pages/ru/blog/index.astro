---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getVisibleBlogPosts } from '@/data/blog';
import { getCopy } from '@/data/site';
const text = getCopy('ru');
const posts = await getVisibleBlogPosts('ru');
---

<BaseLayout locale="ru" title="Блог — Анна Мантра">
  <section class="inner-page section-grid">
    <div>
      <p class="eyebrow">{text.blogEyebrow}</p>
      <h1>{text.blogTitle}</h1>
    </div>
    {posts.length ? (
      <div class="blog-list">
        {posts.map((post) => (
          <article class="blog-list-card">
            <p class="eyebrow">{post.data.status === 'draft' ? 'Черновик · предпросмотр' : 'Статья'}</p>
            <h2><a href={`/ru/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.excerpt}</p>
            {post.data.publishedAt && <time datetime={post.data.publishedAt}>{new Date(`${post.data.publishedAt}T12:00:00Z`).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}</time>}
            <a class="text-link" href={`/ru/blog/${post.id}/`}>Читать статью <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <span class="empty-state-mark">AM</span>
        <p>{text.blogBody}</p>
        <a class="button button-outline" href="/ru/">Вернуться на главную <span aria-hidden="true">↗</span></a>
      </div>
    )}
  </section>
</BaseLayout>
